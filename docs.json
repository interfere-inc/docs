{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Interfere",
  "description": "Investigate application errors with traces, logs, session replays, and release context.",
  "colors": {
    "primary": "#202020",
    "light": "#EEEEEE",
    "dark": "#202020"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#111111"
    }
  },
  "favicon": {
    "light": "/icons/favicon/light.png",
    "dark": "/icons/favicon/dark.png"
  },
  "logo": {
    "href": "https://interfere.com",
    "light": "/icons/logo/light.svg",
    "dark": "/icons/logo/dark.svg"
  },
  "fonts": {
    "$ref": "./config/fonts.json"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "$ref": "./config/navigation.json"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://interfere.com/onboarding"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/interfere_",
      "github": "https://github.com/interfere-inc",
      "linkedin": "https://www.linkedin.com/company/interfere-inc/"
    }
  },
  "appearance": {
    "strict": false
  },
  "seo": {
    "metatags": {
      "og:image": "/og.png",
      "og:image:width": "1200",
      "og:image:height": "630",
      "og:image:alt": "Interfere Documentation",
      "twitter:card": "summary_large_image",
      "twitter:image": "/og.png",
      "twitter:image:alt": "Interfere Documentation"
    }
  },
  "redirects": [
    {
      "source": "/sdk/javascript",
      "destination": "/platform-sdk/typescript"
    },
    {
      "source": "/power-user",
      "destination": "/product/inbox"
    },
    {
      "source": "/integrations/overview",
      "destination": "/product/settings"
    },
    {
      "source": "/onboarding",
      "destination": "/quickstart"
    },
    {
      "source": "/concepts",
      "destination": "/product/problems"
    },
    {
      "source": "/interfere",
      "destination": "/"
    },
    {
      "source": "/product/compliance",
      "destination": "https://interfere.com/security"
    }
  ]
}
